# PostgreSQL Database URL for Prisma
# Schema should be 'leave_tracker' to isolate from other v6 services
DATABASE_URL="postgresql://user:password@localhost:5432/leave_tracker?schema=public"

# JWT Authentication (from tc-core-library-js)
AUTH_SECRET="mysecret"
VALID_ISSUERS='["https://topcoder-dev.auth0.com/","https://api.topcoder.com"]'

# Optional: Prisma transaction timeout (milliseconds)
LEAVE_SERVICE_PRISMA_TIMEOUT=10000

# Optional: visible "To" recipient for monthly leave reminder emails.
# Actual staff recipients are sent in BCC.
LEAVE_REMINDER_TO_EMAIL="no-reply@topcoder.com"

# Isolated Keycloak migration; never enable this branch with Auth0 issuance.
M2M_PROVIDER=keycloak
KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Choose exact approved defaults or a narrower space-delimited scope list.
KEYCLOAK_SCOPE=
# Explicit legacy member-token audience compatibility; does not apply to machines.
ALLOW_LEGACY_USER_AUDIENCE=true
